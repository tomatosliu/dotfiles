# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Theme
ZSH_THEME="powerlevel10k/powerlevel10k"

# Completion settings
HYPHEN_INSENSITIVE="true"
COMPLETION_WAITING_DOTS="true"

# History timestamp format
HIST_STAMPS="yyyy-mm-dd"

# Plugins
# - git: git aliases & completions
# - zsh-autosuggestions: fish-like inline suggestions (accept with →)
# - zsh-syntax-highlighting: real-time command highlighting
# - zsh-completions: extra completion definitions
# - fzf: fuzzy finder integration (Ctrl+R history, Ctrl+T files)
# - z: frecency-based directory jumping
# - extract: `extract` command for any archive format
# - sudo: press ESC twice to prepend sudo
# - copypath: copy current directory path
# - copybuffer: Ctrl+O to copy current command line
# - web-search: `google keyword` from terminal
# - jsontools: pp_json, is_json, urlencode, urldecode
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-completions
  fzf
  z
  extract
  sudo
  copypath
  copybuffer
  web-search
  jsontools
)

source $ZSH/oh-my-zsh.sh

# ── User Configuration ──────────────────────────────────────────

# History
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS  # no duplicate entries
setopt HIST_FIND_NO_DUPS     # no duplicates in search
setopt HIST_SAVE_NO_DUPS     # no duplicates when saving
setopt SHARE_HISTORY         # share history across sessions

# Aliases: modern replacements
alias ls="eza --icons --group-directories-first"
alias ll="eza -l --icons --group-directories-first --git"
alias la="eza -la --icons --group-directories-first --git"
alias tree="eza --tree --icons --level=3"
alias cat="bat --paging=never"

# Aliases: shortcuts
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias md="mkdir -p"
alias ports="lsof -iTCP -sTCP:LISTEN -n -P"
alias myip="curl -s ifconfig.me"
alias reload="source ~/.zshrc"
alias cls="clear"

# Aliases: git extras
alias gs="git status"
alias gd="git diff"
alias glog="git log --oneline --graph --decorate -20"

# zoxide (smarter cd)
eval "$(zoxide init zsh)"

# fzf settings
export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border --margin=1 --padding=1"


. "$HOME/.local/bin/env"

# OpenClaw Completion
source "/Users/sliu/.openclaw/completions/openclaw.zsh"

# Proxy settings for OpenClaw
export https_proxy=http://127.0.0.1:7890
export http_proxy=http://127.0.0.1:7890
export all_proxy=socks5://127.0.0.1:7890

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# Claude Code with skip permissions
alias cc='claude --dangerously-skip-permissions'
